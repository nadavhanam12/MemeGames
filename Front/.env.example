# Leaderboard server base URL (defaults to http://localhost:3151 when unset).
# Copy to .env.local and point at the deployed server for production builds.
VITE_API_BASE=http://localhost:3151

# Dev-only: boot straight into 2x speed + 'gameplay' autoplay (no effect on
# production builds). Handy for hands-off local demos/recordings.
VITE_DEV_AUTOSTART=false
